# TriNetra AI Phase 2 — Environment Configuration
# Copy this file to .env and fill in your values before running docker-compose

# ─── PostgreSQL ───────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trinetra
POSTGRES_USER=trinetra_user
POSTGRES_PASSWORD=trinetra_dev_pass
DATABASE_URL=postgresql+asyncpg://trinetra_user:trinetra_dev_pass@localhost:5432/trinetra

# ─── Redis ────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=trinetra_redis_pass
REDIS_URL=redis://:trinetra_redis_pass@localhost:6379/0

# ─── RabbitMQ ─────────────────────────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=trinetra_admin
RABBITMQ_PASS=trinetra_rabbit_pass
RABBITMQ_URL=amqp://trinetra_admin:trinetra_rabbit_pass@localhost:5672/

# ─── MinIO ────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=trinetra_minio
MINIO_ROOT_PASSWORD=trinetra_minio_pass
MINIO_BUCKET_EVIDENCE=evidence-files
MINIO_SECURE=false

# ─── Elasticsearch ────────────────────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200

# ─── Service Ports ────────────────────────────────────────────────────────
CLAIM_SERVICE_PORT=8080
EVIDENCE_SERVICE_PORT=8081
MULTIMODAL_PROCESSOR_PORT=8082
FRAUD_ENGINE_PORT=8083
VERDICT_GENERATOR_PORT=8084
INTEGRATION_SERVICE_PORT=8085

# ─── External API Keys (Phase 2.4 integrations) ──────────────────────────
# KYC_API_KEY=your_kyc_api_key_here
# SHIPPING_CARRIER_API_KEY=your_carrier_api_key_here
# PAYMENT_PROCESSOR_WEBHOOK_SECRET=your_webhook_secret_here
